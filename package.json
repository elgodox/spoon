{
  "name": "spoon",
  "productName": "Spoon",
  "version": "1.7.4",
  "description": "A fast and friendly Git client for Windows, with AI commit messages.",
  "main": "./out/main/index.js",
  "author": "elgodox",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs",
    "icons": "node scripts/make-icon.cjs",
    "dev": "node scripts/dev.cjs",
    "start": "npm run build && electron .",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run icons && npm run build && electron-builder --win nsis",
    "dist": "npm run pack",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/support/register.mjs --test \"tests/unit/**/*.test.ts\" \"src/**/*.test.ts\"",
    "test:e2e": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "test:visual": "npm run build && node scripts/test-file-actions-ui.cjs && node scripts/test-workspace-history-ui.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "lucide-react": "^1.48.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
